<%# locals: heading, message, details -%>
<div class="empty">
  <%- icon('alert', { size: 40, class: 'empty__icon' }) %>
  <h1><%= heading %></h1>
  <p class="subtle selectable"><%= message %></p>
  <a class="button" href="#/">Zur Übersicht</a>
  <% if (details) { %><pre class="error-details selectable"><%= details %></pre><% } %>
</div>
