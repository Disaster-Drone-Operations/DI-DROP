<%# locals: entry, mission -%>
<% const { viewpoint, shots, flightCount, variants, latest } = entry -%>
<% const preview = latest && (latest.files.T ?? latest.files.V ?? Object.values(latest.files)[0]) -%>
<div class="viewpoint-row">
  <label class="viewpoint-row__select">
    <input type="checkbox" value="<%= viewpoint.id %>" data-comparisons-target="checkbox" data-action="comparisons#toggle"
           data-name="<%= viewpoint.name %>" data-shots="<%= JSON.stringify(shots) %>" data-variants="<%= JSON.stringify(variants) %>">
    <% if (preview?.thumb) { %><img class="viewpoint-row__thumb" src="<%= thumbUrl(preview.thumb) %>" alt="" loading="lazy" draggable="false"><% } else { %><span class="viewpoint-row__thumb"></span><% } %>
    <span class="viewpoint-row__text">
      <strong class="truncate"><%= viewpoint.name %></strong>
      <span class="subtle"><%= pluralize(flightCount, 'Flug', 'Flüge') %> · <%= pluralize(shots.length, 'Aufnahme', 'Aufnahmen') %></span>
    </span>
  </label>
  <details class="rename">
    <summary class="button button--icon" title="Umbenennen"><%- icon('pencil', { size: 14 }) %></summary>
    <form action="#/missions/<%= mission.id %>/viewpoints/<%= viewpoint.id %>" method="post" class="rename__form">
      <input type="hidden" name="_method" value="patch">
      <input type="text" name="viewpoint[custom_name]" value="<%= viewpoint.custom_name ?? '' %>" placeholder="<%= viewpoint.direction %> (automatisch)">
      <button type="submit" class="button">OK</button>
    </form>
  </details>
</div>
