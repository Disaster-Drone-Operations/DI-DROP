<%# locals: active, archived, upcoming, status, steps -%>
<header class="page-header">
  <div>
    <h1>Einsätze</h1>
    <p class="subtle">Einsätze und Übungen der Drohnengruppe. Bilder, Vergleichsbilder und Bereitstellen findest du im jeweiligen Einsatz.</p>
  </div>
  <a class="button button--primary" href="#/missions/new"><%- icon('plus') %><span>Neuer Einsatz</span></a>
</header>

<section class="section">
  <h2 class="section__title">Aktiv <span class="count"><%= active.length %></span></h2>
  <% if (active.length === 0) { -%>
    <div class="empty">
      <%- icon('drone', { size: 40, class: 'empty__icon' }) %>
      <p><strong>Gerade kein aktiver Einsatz.</strong></p>
      <p class="subtle">Oben rechts „Neuer Einsatz“ – oder einfach die SD-Karte einstecken, di-drop bietet dann an, einen Einsatz anzulegen.</p>
    </div>
  <% } else { -%>
    <div class="list">
      <% active.forEach((mission) => { %><%- include('missions/_card', { mission, status: status.get(mission.id) }) %><% }) %>
    </div>
  <% } -%>
</section>

<% if (upcoming.length) { -%>
  <section class="section">
    <h2 class="section__title">Als Nächstes zu tun <span class="count"><%= upcoming.length %></span></h2>
    <div class="task-grid">
      <% upcoming.forEach((a) => { %><%- include('assignments/_card', { assignment: a, counts: null, steps: steps.get(a.id), returnTo: '/', showMission: active.length > 1 }) %><% }) %>
    </div>
  </section>
<% } -%>

<% if (archived.length) { -%>
  <details class="disclosure section">
    <summary>Abgeschlossen <span class="count"><%= archived.length %></span></summary>
    <div class="disclosure__body list list--muted">
      <% archived.forEach((mission) => { %><%- include('missions/_card', { mission, status: null }) %><% }) %>
    </div>
  </details>
<% } -%>
