<%# locals: mission, open, done, history, timeline, counts, canImport, newAssignment, newAssignmentParams, showNewAssignment -%>
<% const path = `/missions/${mission.id}` -%>
<header class="page-header">
  <div>
    <a class="backlink" href="#/">Einsätze</a>
    <div class="eyebrow">
      <%- kindBadge(mission) %>
      <% if (!mission.isActive) { %><span class="badge badge--muted">Abgeschlossen</span><% } %>
      <% if (mission.reference) { %><span class="subtle">Nr. <%= mission.reference %></span><% } %>
    </div>
    <h1><%= mission.title %></h1>
    <div class="meta meta--large">
      <span><%- icon('calendar', { size: 14 }) %><%= formatDate(mission.date) %><% if (mission.start_time) { %>, <%= mission.start_time %> Uhr<% } %></span>
      <span><%- icon('pin', { size: 14 }) %><%= mission.location %></span>
    </div>
  </div>
  <div class="toolbar">
    <a class="button" href="#<%= path %>/comparisons"><%- icon('kontrolle') %><span>Vergleichsbilder</span></a>
    <a class="button" href="#<%= path %>/edit"><%- icon('pencil') %><span>Bearbeiten</span></a>
    <% if (mission.isActive) { -%>
      <%- buttonTo('Abschließen', path, { method: 'patch', icon: 'archive', params: { 'mission[status]': 'abgeschlossen' },
            confirm: `„${mission.title}“ abschließen? Er erscheint dann unter „Abgeschlossen“ und kann jederzeit wieder geöffnet werden.`,
            confirmButton: 'Abschließen' }) %>
    <% } else { -%>
      <%- buttonTo('Wieder öffnen', path, { method: 'patch', icon: 'reopen', params: { 'mission[status]': 'aktiv' } }) %>
    <% } -%>
  </div>
</header>

<div class="columns" data-controller="media-import" data-media-import-mission-id-value="<%= mission.id %>" data-media-import-return-path-value="<%= path %>">
  <div class="columns__main">
    <% if (mission.isActive) { %><%- include('media/_import_zone', { canImport, label: null }) %><% } %>

    <section class="section">
      <h2 class="section__title">Verlauf</h2>
      <% if (!history.length) { -%>
        <div class="empty empty--compact"><p class="subtle">Noch keine Bilder. Nach dem Flug einfach die SD-Karte oder den Ordner hierher – oder direkt auf einen Auftrag rechts – ziehen.</p></div>
      <% } else { -%>
        <div class="history">
          <% history.forEach((a) => { %><%- include('assignments/_history', { assignment: a, entry: timeline.get(a.id) }) %><% }) %>
        </div>
      <% } -%>
    </section>

    <details class="disclosure disclosure--card section">
      <summary>Einsatzdaten &amp; Einheit <span class="disclosure__hint">– <%= mission.location %><%= mission.operator ? ` · Drone Operator: ${mission.operator}` : '' %></span></summary>
      <div class="disclosure__body mission-details">
        <dl class="details">
          <% missionRoles().forEach(([attr, label]) => { -%>
            <dt><%= label %></dt><dd><%= mission[attr] || '–' %></dd>
          <% }) -%>
          <dt>Ort</dt><dd><%= mission.location %></dd>
          <% if (mission.coordinates) { %><dt>Koordinaten</dt><dd class="mono selectable"><%= mission.coordinates %></dd><% } %>
          <% if (mission.requested_by) { %><dt>Angefordert</dt><dd><%= mission.requested_by %></dd><% } %>
        </dl>
        <% if (mission.notes) { %><p class="notes selectable"><%= mission.notes %></p><% } %>
        <div class="danger-zone">
          <%- buttonTo(`${mission.kindLabel} löschen`, path, { method: 'delete', icon: 'trash', class: 'button button--danger-quiet',
                confirm: `„${mission.title}“ mit allen Aufträgen endgültig löschen? Die Bilddateien bleiben im Ordner erhalten.`, confirmButton: 'Löschen' }) %>
        </div>
      </div>
    </details>
  </div>

  <aside class="columns__side tasks">
    <div class="tasks__header">
      <h2 class="section__title">Aufträge <span class="count"><%= open.length %></span></h2>
      <% if (mission.isActive) { %><%- include('assignments/_new_dialog', { mission, newAssignment, newAssignmentParams, open: showNewAssignment, returnTo: path }) %><% } %>
    </div>

    <% if (!open.length) { -%>
      <div class="empty empty--compact"><p class="subtle">Keine offenen Aufträge.</p></div>
    <% } -%>
    <% open.forEach((a) => { %><%- include('assignments/_card', { assignment: a, counts, returnTo: path, showMission: false }) %><% }) %>

    <% if (done.length) { -%>
      <details class="disclosure tasks__done">
        <summary>Erledigt <span class="count"><%= done.length %></span></summary>
        <div class="disclosure__body tasks__list">
          <% done.forEach((a) => { -%>
            <div class="task-row">
              <%- icon('check', { size: 14 }) %>
              <a href="#<%= path %>/assignments/<%= a.id %>" class="truncate"><%= a.title %></a>
              <span class="subtle"><%= counts.get(a.id) ? `${counts.get(a.id).shots} Aufn.` : '' %></span>
              <%- buttonTo('Wieder öffnen', `${path}/assignments/${a.id}/reopen`, { method: 'patch', icon: 'reopen', class: 'button button--icon-quiet', params: { return_to: path } }) %>
            </div>
          <% }) -%>
        </div>
      </details>
    <% } -%>
  </aside>

  <dialog class="import-dialog" data-media-import-target="dialog"></dialog>
</div>
