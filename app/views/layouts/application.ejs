<%# locals: body, flash, currentPath, unitName, activeMissions -%>
<div class="window">
  <aside class="sidebar">
    <div class="titlebar" data-tauri-drag-region></div>

    <div class="brand">
      <span class="brand__logo"><%- icon('drone', { size: 18 }) %></span>
      <div class="brand__text">
        <div class="brand__name">di-drop</div>
        <div class="brand__unit"><%= unitName || 'Disaster Drone Operator' %></div>
      </div>
    </div>

    <nav class="nav">
      <div class="nav__heading">Module</div>
      <a href="#/" class="nav__item <%= isCurrent(currentPath, '/', { exact: true }) || currentPath === '/missions/new' ? 'is-active' : '' %>">
        <%- icon('missions') %><span>Einsätze</span>
      </a>
      <a href="#/media" class="nav__item <%= isCurrent(currentPath, '/media') || /^\/missions\/\d+\/(flights|comparisons)/.test(currentPath) ? 'is-active' : '' %>">
        <%- icon('images') %><span>Bilddaten</span>
      </a>
      <a href="#/location" class="nav__item <%= isCurrent(currentPath, '/location') ? 'is-active' : '' %>" data-controller="location-nav">
        <%- icon('pin') %><span>Mein Standort</span><span class="badge badge--live badge--tiny" data-location-nav-target="live" hidden>Live</span>
      </a>
      <span class="nav__item is-disabled" title="Kommt später">
        <%- icon('radar') %><span>Luftraum</span><span class="badge badge--muted badge--tiny">bald</span>
      </span>
      <a href="#/flightlogs" class="nav__item <%= isCurrent(currentPath, '/flightlogs') ? 'is-active' : '' %>">
        <%- icon('protocol') %><span>Flugprotokolle</span>
      </a>
      <a href="#/batteries" class="nav__item <%= isCurrent(currentPath, '/batteries') ? 'is-active' : '' %>">
        <%- icon('battery') %><span>Akkunutzung</span>
      </a>

      <% if (activeMissions.length) { -%>
        <div class="nav__heading">Aktive Einsätze</div>
        <% activeMissions.forEach((m) => { -%>
          <a href="#/missions/<%= m.id %>" class="nav__item nav__item--sub <%= currentPath === `/missions/${m.id}` || currentPath === `/missions/${m.id}/edit` ? 'is-active' : '' %>" title="<%= m.title %>">
            <span class="dot dot--<%= m.kind %>"></span><span class="truncate"><%= m.title %></span>
          </a>
        <% }) -%>
      <% } -%>
    </nav>

    <% if (!hasNativeMenu()) { -%>
      <%# macOS: settings only in the „di-drop“ app menu (like Mail) -%>
      <nav class="nav nav--bottom">
        <a href="#/settings" class="nav__item <%= isCurrent(currentPath, '/settings') ? 'is-active' : '' %>">
          <%- icon('settings') %><span>Einstellungen</span>
        </a>
      </nav>
    <% } -%>

    <div class="flightlog-progress" data-controller="flightlog-progress" hidden></div>

    <%# Uploads in the very bottom-left corner (like the activity indicator in Mail) -%>
    <a href="#/uploads" class="upload-status <%= isCurrent(currentPath, '/uploads') ? 'is-active' : '' %>" data-controller="upload-status" hidden></a>
  </aside>

  <main class="content">
    <div class="titlebar" data-tauri-drag-region></div>
    <% if (flash.notice || flash.alert) { -%>
      <div class="toast <%= flash.alert ? 'toast--alert' : '' %>" data-controller="flash" role="status"
           <% if (flash.undo) { %>data-flash-delay-value="7000"<% } %>>
        <%- icon(flash.alert ? 'alert' : 'check') %><span><%= flash.notice || flash.alert %></span>
        <% if (flash.undo) { %><button type="button" class="toast__undo" data-action="flash#undo" title="<%= shortcut('Mod+Z') %>">Widerrufen</button><% } %>
      </div>
    <% } -%>
    <div class="page" data-controller="provision">
      <%- body %>
    </div>
  </main>
  <%- include('layouts/_gallery') %>
  <%- include('layouts/_shortcuts') %>
</div>
