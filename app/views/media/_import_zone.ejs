<%# locals: canImport, label, compact, primary -%>
<%# compact: images already there → one slim line (the next step is shown elsewhere) -%>
<% if (canImport && compact) { -%>
  <div class="dropzone dropzone--compact" data-media-import-target="zone">
    <%- icon('import', { size: 16, class: 'icon dropzone__icon' }) %>
    <span class="subtle dropzone__text">Weitere Bilder: SD-Karte einstecken oder Ordner hierher ziehen<%= label ? '' : ' – oder direkt auf einen Auftrag' %>.</span>
    <button type="button" class="button button--small" data-action="media-import#pickFolder"><%- icon('folder', { size: 13 }) %><span>Ordner wählen …</span></button>
    <button type="button" class="button button--small button--quiet" data-action="media-import#pickFiles">Einzelne Bilder …</button>
  </div>
<% } else if (canImport) { -%>
  <div class="dropzone" data-media-import-target="zone">
    <%- icon('import', { size: 22, class: 'icon dropzone__icon' }) %>
    <div class="dropzone__text">
      <strong><%= label ?? 'Bilder nach dem Flug importieren' %></strong>
      <span class="subtle">SD-Karte oder Ordner hierher ziehen<%= label ? '' : ' – oder direkt auf einen Auftrag' %>. Bereits importierte Bilder werden übersprungen.</span>
    </div>
    <div class="dropzone__actions">
      <button type="button" class="button <%= primary ? 'button--primary' : '' %>" data-action="media-import#pickFolder"><%- icon('folder') %><span>Ordner wählen …</span></button>
      <button type="button" class="button button--quiet" data-action="media-import#pickFiles">Einzelne Bilder …</button>
    </div>
  </div>
<% } else { -%>
  <div class="callout callout--subtle"><%- icon('alert') %><span>Bilder importieren geht nur in der Desktop-App.</span></div>
<% } -%>
