<%# locals: s -%>
<%- include('settings/_relay_diagram', { s }) %>

<% if (s.url && !s.setup) { -%>
  <% if (s.health === 'outdated') { -%>
    <div class="callout callout--warning"><%- icon('alert') %><span>Eine neuere Version (<%= s.latest %>) ist verfügbar – z. B. für „An Telefon senden“.<%= s.managed ? ' Das Aktualisieren dauert etwa eine Minute.' : ' Bei einem eigenen Relay-Server bitte dort aktualisieren.' %></span></div>
  <% } else if (s.health === 'down') { -%>
    <p class="hint">Ohne Internet kann das Telefon nichts senden oder empfangen. Ist die Verbindung da und der Relay trotzdem nicht erreichbar, den Relay neu installieren.</p>
  <% } -%>
  <% if (s.progress) { -%>
    <p class="location-status"><span class="spinner"></span><span><%= s.progress %></span></p>
  <% } -%>
  <% if (s.error) { -%>
    <div class="callout callout--danger"><%- icon('alert') %><span><%= s.error %></span></div>
  <% } -%>
  <div class="toolbar relay-actions">
    <% if (s.available && s.managed && s.health === 'outdated') { -%>
      <button type="button" class="button button--primary" data-action="relay-setup#update" <%= s.busy ? 'disabled' : '' %>>Jetzt aktualisieren</button>
    <% } else if (s.available && s.managed && s.health === 'down') { -%>
      <button type="button" class="button button--primary" data-action="relay-setup#update" <%= s.busy ? 'disabled' : '' %>>Neu installieren</button>
    <% } -%>
    <button type="button" class="button" data-action="relay-setup#check" <%= s.busy ? 'disabled' : '' %>>Verbindung testen</button>
    <% if (s.available && s.managed) { -%>
      <button type="button" class="button button--danger-quiet" data-action="relay-setup#uninstall" <%= s.busy ? 'disabled' : '' %>>Deinstallieren …</button>
    <% } -%>
    <% if (s.hasToken) { %><button type="button" class="button button--quiet" data-action="relay-setup#forgetToken" title="Der Schlüssel wird nur zum Installieren, Aktualisieren und Deinstallieren gebraucht." <%= s.busy ? 'disabled' : '' %>>Cloudflare-Schlüssel entfernen</button><% } %>
  </div>
<% } else if (!s.available) { -%>
  <div class="callout callout--subtle"><%- icon('alert') %><span>Die Einrichtung bei Cloudflare geht nur in der Desktop-App. Hier im Browser kannst du unten die Adresse eines vorhandenen Relays eintragen.</span></div>
<% } else { -%>
  <ol class="relay-steps">
    <li class="<%= s.step === 'account' ? 'is-active' : 'is-done' %>">
      <span class="stepper__num"><%= s.step === 'account' ? '1' : '✓' %></span>
      <div>
        <strong>Cloudflare-Konto</strong>
        <% if (s.step === 'account') { -%>
          <p class="subtle">Kostenlos, nur E-Mail-Adresse und Passwort nötig. Das Konto gehört dir – di-drop speichert keine Zugangsdaten.</p>
          <div class="toolbar relay-actions">
            <button type="button" class="button" data-action="relay-setup#openSignup">Konto anlegen …</button>
            <button type="button" class="button button--primary" data-action="relay-setup#haveAccount">Ich habe ein Konto</button>
          </div>
        <% } -%>
      </div>
    </li>

    <li class="<%= s.step === 'token' ? 'is-active' : s.step === 'account' ? 'is-disabled' : 'is-done' %>">
      <span class="stepper__num"><%= ['account', 'token'].includes(s.step) ? '2' : '✓' %></span>
      <div>
        <strong>Zugangsschlüssel</strong>
        <% if (s.step === 'token') { -%>
          <p class="subtle">Cloudflare öffnet eine Seite, auf der die nötigen Rechte schon ausgewählt sind. Dort ganz unten <em>„Weiter zur Zusammenfassung“</em> und dann <em>„Token erstellen“</em> klicken und den Schlüssel kopieren.</p>
          <div class="toolbar relay-actions"><button type="button" class="button" data-action="relay-setup#openTokenPage">Schlüssel bei Cloudflare erstellen …</button></div>
          <form class="input-with-button relay-token" data-action="submit->relay-setup#saveToken">
            <input type="password" name="token" placeholder="Schlüssel hier einfügen" autocomplete="off" spellcheck="false" data-relay-setup-target="token" <%= s.busy ? 'disabled' : '' %>>
            <button type="submit" class="button button--primary" <%= s.busy ? 'disabled' : '' %>>Einrichten</button>
          </form>
          <p class="hint">Der Schlüssel wird im Schlüsselbund des Computers gespeichert – nicht in di-drop und nie auf dem Smartphone.</p>
        <% } -%>
      </div>
    </li>

    <li class="<%= s.step === 'install' ? 'is-active' : 'is-disabled' %>">
      <span class="stepper__num">3</span>
      <div>
        <strong>Relay installieren</strong>
        <% if (s.step === 'install') { -%>
          <% if (s.accounts?.length > 1 && !s.accountId) { -%>
            <p class="subtle">Der Schlüssel hat Zugriff auf mehrere Konten. Welches soll den Relay bekommen?</p>
            <div class="toolbar relay-actions" style="justify-content:flex-start">
              <% s.accounts.forEach((a) => { %><button type="button" class="button" data-action="relay-setup#chooseAccount" data-relay-setup-id-param="<%= a.id %>"><%= a.name %></button><% }) %>
            </div>
          <% } else if (s.needsSubdomain) { -%>
            <p class="subtle">Dein Konto braucht noch einen Namen für seine Internet-Adresse (einmalig, später nicht mehr änderbar). Die Adresse wird dann <span class="mono">di-drop-relay.<em>name</em>.workers.dev</span>.</p>
            <form class="input-with-button relay-token" data-action="submit->relay-setup#createSubdomain">
              <input type="text" name="subdomain" value="<%= s.suggestion %>" autocomplete="off" spellcheck="false" data-relay-setup-target="subdomain" <%= s.busy ? 'disabled' : '' %>>
              <button type="submit" class="button button--primary" <%= s.busy ? 'disabled' : '' %>>Weiter</button>
            </form>
          <% } -%>
          <% if (s.progress) { -%>
            <p class="location-status"><span class="spinner"></span><span><%= s.progress %></span></p>
          <% } else if (!s.busy && !s.needsSubdomain && !(s.accounts?.length > 1 && !s.accountId)) { -%>
            <p class="subtle">Der Cloudflare-Schlüssel ist im Schlüsselbund gespeichert. Die Installation dauert etwa eine Minute.</p>
            <div class="toolbar relay-actions">
              <button type="button" class="button button--primary" data-action="relay-setup#install">Relay installieren</button>
              <button type="button" class="button button--quiet" data-action="relay-setup#forgetToken">Anderen Schlüssel verwenden …</button>
            </div>
          <% } -%>
        <% } -%>
      </div>
    </li>
  </ol>

  <% if (s.error) { -%>
    <div class="callout callout--danger"><%- icon('alert') %><span><%= s.error %></span></div>
  <% } -%>
  <% if (s.url) { -%>
    <div class="toolbar relay-actions" style="justify-content:flex-start"><button type="button" class="button button--quiet" data-action="relay-setup#cancelSetup">Abbrechen</button></div>
  <% } -%>
<% } -%>
