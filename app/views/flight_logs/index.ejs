<%# locals: logs, groups, names, battery, missions, missionFilter, filterMission, unassigned, available, dir, canPickFolder, people -%>
<% const named = (kind, sn) => names.get(`${kind}:${sn}`) -%>
<% const personOf = new Map(people.map((p) => [p.id, p])) -%>
<% const path = `/flightlogs${missionFilter ? `?mission=${missionFilter}` : battery ? `?battery=${encodeURIComponent(battery)}` : ''}` -%>
<div class="flightlogs" data-controller="flight-logs">
  <header class="page-header">
    <div>
      <h1>Flugprotokolle</h1>
      <p class="subtle">Alle Flüge aus den Protokollen der DJI-Fernsteuerung. Neue Flüge übernehmen: <strong>1.</strong> Fernsteuerung einschalten, <strong>2.</strong> per USB-C an den Rechner anschließen – di-drop fragt dann, ob es die neuen übernehmen soll.</p>
    </div>
    <% if (available) { -%>
      <div class="toolbar">
        <button type="button" class="button" data-action="flight-logs#importFolder" title="z. B. ein USB-Stick mit dem Ordner „FlightRecord“"><%- icon('folder') %><span>Aus Ordner übernehmen …</span></button>
        <button type="button" class="button button--primary" data-action="flight-logs#importDevice" data-flight-logs-target="deviceButton" hidden><%- icon('import') %><span>Von Fernsteuerung übernehmen</span></button>
      </div>
    <% } -%>
  </header>

  <% if (battery) { -%>
    <div class="flightlogs__filter">
      <span>Nur Flüge mit <strong><%= named('battery', battery) ?? battery %></strong></span>
      <a class="button button--small" href="#/flightlogs">Alle Flüge zeigen</a>
      <a class="button button--small button--quiet" href="#/batteries">Zur Akkunutzung</a>
    </div>
  <% } else if (filterMission) { -%>
    <div class="flightlogs__filter">
      <span>Nur Flüge von <strong><%= filterMission.title %></strong></span>
      <a class="button button--small" href="#/flightlogs">Alle Flüge zeigen</a>
      <a class="button button--small button--quiet" href="#/missions/<%= filterMission.id %>">Zum Einsatz</a>
    </div>
  <% } else if (missionFilter === 'none' || unassigned) { -%>
    <nav class="filterbar" aria-label="Flüge">
      <span class="subtle">Anzeigen:</span>
      <div class="segmented segmented--links">
        <a href="#/flightlogs" class="<%= missionFilter ? '' : 'is-active' %>">Alle Flüge</a>
        <a href="#/flightlogs?mission=none" class="<%= missionFilter === 'none' ? 'is-active' : '' %>">Ohne Einsatz (<%= unassigned %>)</a>
      </div>
    </nav>
  <% } -%>

  <% if (!available) { -%>
    <div class="callout callout--subtle"><%- icon('alert') %><span>Flugprotokolle lassen sich nur in der Desktop-App übernehmen.</span></div>
  <% } -%>

  <% if (!logs.length && (missionFilter || battery)) { -%>
    <div class="empty empty--compact">
      <p class="subtle"><%= missionFilter === 'none' ? 'Alle Flüge sind einem Einsatz zugeordnet.' : filterMission ? 'Diesem Einsatz ist noch kein Flug zugeordnet.' : 'Keine passenden Flüge.' %></p>
    </div>
  <% } else if (!logs.length) { -%>
    <div class="empty empty--steps">
      <%- icon('protocol', { size: 40, class: 'empty__icon' }) %>
      <p><strong>Noch keine Flugprotokolle.</strong> So kommen sie herein:</p>
      <ol class="flow-steps">
        <li><strong>Fernsteuerung einschalten</strong> (z. B. DJI RC Plus 2) – ausgeschaltet erkennt der Rechner sie nicht.</li>
        <li><strong>Per USB-C an den Rechner anschließen</strong> – di-drop erkennt sie und übernimmt alle neuen Flugprotokolle.</li>
      </ol>
      <p class="subtle">Alternativ: Ordner <span class="mono">FlightRecord</span> (auf der Fernsteuerung unter <span class="mono">DJI/com.dji.industry.pilot</span>) auf einen USB-Stick kopieren und „Aus Ordner übernehmen …“ wählen.</p>
    </div>
  <% } else { -%>
    <div class="flightlogs__table-wrap">
      <table class="flightlogs__table" data-flight-logs-target="table">
        <thead>
          <tr>
            <th class="flightlogs__check" data-action="click->flight-logs#allCell"><input type="checkbox" aria-label="Alle auswählen" data-flight-logs-target="all" data-action="change->flight-logs#toggleAll"></th>
            <th>Datum</th>
            <th class="num">Start</th>
            <th class="num">Landung</th>
            <th class="num">Flugdauer</th>
            <th class="num">Strecke</th>
            <th class="flightlogs__crew-head" lang="de" title="<%= roleLabel('pilot') %>"><%= roleLabel('pilot') %></th>
            <th class="flightlogs__crew-head" lang="de" title="<%= roleLabel('observer') %>"><%= roleLabel('observer') %></th>
            <th>Drohne</th>
            <th>Akku</th>
          </tr>
        </thead>
        <% groups.forEach((group) => { -%>
          <tbody class="flightlogs__group">
            <% const m = group.mission -%>
            <%# Click: select all flights of the mission – all of its parts (⌘/Ctrl: add to / remove from the selection) -%>
            <tr class="flightlogs__group-head" data-action="click->flight-logs#selectGroup" data-group="<%= group.key %>"
                title="Klicken: <%= m ? 'alle Flüge dieses Einsatzes' : 'alle Flüge dieses Blocks' %> markieren">
              <td colspan="10">
                <% if (m) { -%>
                  <%- kindBadge(m) %>
                  <span class="flightlogs__group-title"><%= m.title %></span>
                  <span class="subtle"><%= formatDate(m.date, { weekday: false }) %></span>
                  <% if (group.part) { %><span class="badge badge--muted badge--tiny">Teil <%= group.part.n %> von <%= group.part.of %></span><% } %>
                <% } else { -%>
                  <% const [newest, oldest] = [localDay(group.logs[0].started_at), localDay(group.logs.at(-1).started_at)] -%>
                  <span class="badge badge--muted">Unbekannt</span>
                  <span class="flightlogs__group-title">Ohne Einsatz</span>
                  <span class="subtle"><%= newest === oldest ? newest : `${oldest} – ${newest}` %></span>
                <% } -%>
                <span class="subtle"><%= pluralize(group.logs.length, 'Flug', 'Flüge') %></span>
              </td>
            </tr>
            <% group.logs.forEach((log) => { -%>
              <%# Double-click on a flight: change its mission (of all selected flights) – later the flight details (TODO.md) -%>
              <tr class="flightlogs__row" data-flight-logs-target="row" data-id="<%= log.id %>" data-duration="<%= log.duration_s ?? 0 %>" data-distance="<%= log.distance_m ?? 0 %>" data-mission="<%= log.mission_id ?? '' %>" data-group="<%= group.key %>"
                  data-pilot="<%= log.pilot_id ?? '' %>" data-pilot-source="<%= log.pilot_source ?? '' %>" data-observer="<%= log.observer_id ?? '' %>" data-observer-source="<%= log.observer_source ?? '' %>"
                  data-action="click->flight-logs#select dblclick->flight-logs#editMission"
                  title="<%= m ? (log.mission_source === 'manual' ? 'Von Hand zugeordnet' : 'Automatisch zugeordnet (Bilder bzw. Zeit des Einsatzes)') : (log.mission_source === 'manual' ? 'Von Hand: kein Einsatz' : 'Kein passender Einsatz gefunden') %> – Doppelklick: <%= m ? 'Einsatz ändern' : 'Einsatz zuordnen' %>">
                <td class="flightlogs__check"><input type="checkbox" tabindex="-1" aria-label="Flug auswählen"></td>
                <td title="<%= log.file_name %>"><%= localDate(log.started_at) %></td>
                <td class="num"><%= localTime(log.started_at) %></td>
                <td class="num"><%= localTime(log.landed_at) %></td>
                <td class="num"><%= formatFlightDuration(log.duration_s) %></td>
                <td class="num"><%= formatDistance(log.distance_m) %></td>
                <% ['pilot', 'observer'].forEach((role) => { const person = personOf.get(log[`${role}_id`]) -%>
                  <%# Double-click here: change pilot / airspace observer (instead of the mission) -%>
                  <td class="flightlogs__crew" data-crew-cell title="<%= roleLabel(role) %>: <%= person?.name ?? 'niemand' %> – <%= log[`${role}_source`] === 'manual' ? 'von Hand' : log.mission_id ? 'aus der Besetzung des Einsatzes' : 'ohne Einsatz von Hand eintragen' %> · Doppelklick: ändern">
                    <% if (person) { %><span class="person-initials person-initials--small <%= log[`${role}_source`] === 'manual' ? 'is-manual' : '' %>"><%= person.short %></span><% } else { %><span class="subtle">–</span><% } %>
                  </td>
                <% }) -%>
                <td>
                  <% if (log.aircraft_sn) { -%>
                    <span class="renamable flightlogs__name <%= named('aircraft', log.aircraft_sn) ? 'is-named' : '' %>" title="<%= log.aircraft_name ?? 'Drohne' %>" data-controller="device-name"
                          data-device-name-kind-value="aircraft" data-device-name-serial-value="<%= log.aircraft_sn %>"><%= named('aircraft', log.aircraft_sn) ?? log.aircraft_sn %></span>
                  <% } else { %><%= log.aircraft_name ?? '–' %><% } %>
                </td>
                <td>
                  <% if (log.battery_sn) { -%>
                    <span class="renamable flightlogs__battery <%= named('battery', log.battery_sn) ? 'is-named' : '' %>" data-controller="device-name"
                          data-device-name-kind-value="battery" data-device-name-serial-value="<%= log.battery_sn %>"><%= named('battery', log.battery_sn) ?? log.battery_sn %></span>
                  <% } else { %>–<% } %>
                </td>
              </tr>
            <% }) -%>
          </tbody>
        <% }) -%>
      </table>
    </div>

    <%# Totals bar like in Numbers: the selection or – without a selection – all flights -%>
    <footer class="flightlogs__sum" data-flight-logs-target="sum"></footer>

    <%# „Einsatz zuordnen …“ for the selected flights (flight_logs_controller fills ids + suggestions) -%>
    <dialog class="sheet flightlogs__assign" data-flight-logs-target="assignDialog">
      <form class="sheet__body" action="#/flightlogs/mission" method="post">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="ids" data-flight-logs-target="assignIds">
        <input type="hidden" name="return_to" value="<%= path %>">
        <h2 class="dialog__title" data-flight-logs-target="assignTitle">Einsatz zuordnen</h2>
        <div class="choices flightlogs__missions" data-flight-logs-target="assignList">
          <% missions.forEach((m) => { -%>
            <label class="choice" data-mission-option="<%= m.id %>">
              <input type="radio" name="mission" value="<%= m.id %>">
              <span class="choice__label"><%= m.title %><span class="flightlogs__suggested">passt zur Flugzeit</span></span>
              <span class="choice__result"><%= formatDate(m.date, { weekday: false }) %></span>
            </label>
          <% }) -%>
          <% if (!missions.size) { %><p class="hint">Noch keine Einsätze angelegt.</p><% } %>
        </div>
        <div class="choices">
          <label class="choice"><input type="radio" name="mission" value="none"><span class="choice__label">Keinem Einsatz zuordnen</span><span class="choice__result subtle">z. B. Übungs- oder Testflug</span></label>
          <label class="choice"><input type="radio" name="mission" value="auto"><span class="choice__label">Automatisch zuordnen</span><span class="choice__result subtle">nach Bildern und Zeit</span></label>
        </div>
        <div class="dialog__actions">
          <button type="button" class="button" data-action="flight-logs#closeAssign">Abbrechen</button>
          <button type="submit" class="button button--primary">Zuordnen</button>
        </div>
      </form>
    </dialog>

    <%# „Besetzung ändern …“: pilot and airspace observer of the selected flights (flight_logs_controller.js) -%>
    <dialog class="sheet" data-flight-logs-target="crewDialog">
      <form class="sheet__body" action="#/flightlogs/crew" method="post" data-action="submit->flight-logs#crewSubmit">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="ids" data-flight-logs-target="crewIds">
        <input type="hidden" name="return_to" value="<%= path %>">
        <h2 class="dialog__title" data-flight-logs-target="crewTitle">Besetzung ändern</h2>
        <% ['pilot', 'observer'].forEach((role) => { -%>
          <div class="field">
            <label class="field__label" for="flight_<%= role %>"><%= roleLabel(role) %></label>
            <%- include('people/_picker', { name: role, inputId: `flight_${role}`, selected: '',
                  extra: [['keep', '– wie bisher –'], ['auto', 'Automatisch (Besetzung des Einsatzes)']] }) %>
          </div>
        <% }) -%>
        <p class="hint">Automatisch: wer laut Besetzung des Einsatzes zur Startzeit des Flugs <%= roleLabel('pilot') %> bzw. <%= roleLabel('observer') %> war. Von Hand Eingetragenes bleibt, auch wenn sich die Besetzung ändert.</p>
        <div class="dialog__actions">
          <button type="button" class="button" data-action="flight-logs#closeCrew">Abbrechen</button>
          <button type="submit" class="button button--primary">Übernehmen</button>
        </div>
      </form>
    </dialog>
  <% } -%>

  <% if (dir && logs.length) { -%>
    <p class="hint flightlogs__dir" data-controller="system-open">
      Originaldateien: <span class="mono selectable"><%= dir %></span>
      <button type="button" class="button button--small button--quiet" data-action="system-open#reveal" data-system-open-path-param="<%= dir %>"><%= platformName() === 'windows' ? 'Im Explorer zeigen' : 'Im Finder zeigen' %></button>
    </p>
  <% } -%>
</div>
