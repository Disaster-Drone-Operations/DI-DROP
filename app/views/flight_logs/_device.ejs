<%# locals: state, device, status, progress, result, error -%>
<%# Same look as the memory card dialog (media/_import_dialog) -%>
<% const MAX = 8 -%>
<% const when = (name) => { const m = /(\d{4})-(\d{2})-(\d{2})_\[(\d{2})-(\d{2})/.exec(name); return m ? `${m[3]}.${m[2]}.${m[1]}, ${m[4]}:${m[5]} Uhr` : name } -%>
<div class="dialog">
  <div class="import-card">
    <%- icon('drone', { size: 22 }) %>
    <div>
      <h2 class="dialog__title">Fernsteuerung erkannt</h2>
      <p class="subtle">„<%= device.name %>“</p>
    </div>
  </div>

  <% if (state === 'offer') { -%>
    <p class="lead"><strong><%= pluralize(status.new, 'neues Flugprotokoll', 'neue Flugprotokolle') %></strong> gefunden<%= status.total > status.new ? ` (insgesamt ${status.total} auf der Fernsteuerung)` : '' %>.</p>
    <ul class="flightlog-offer">
      <% status.new_files.slice(0, MAX).forEach((name) => { -%>
        <li><%- icon('protocol', { size: 14 }) %><span><%= when(name) %></span></li>
      <% }) -%>
      <% if (status.new_files.length > MAX) { %><li class="subtle">+ <%= status.new_files.length - MAX %> weitere</li><% } %>
    </ul>
    <p class="subtle">Die Originaldateien werden unverändert übernommen und bleiben auch auf der Fernsteuerung.</p>
    <div class="dialog__actions">
      <button type="button" class="button" data-action="flightlog-device#close">Später</button>
      <button type="button" class="button button--primary" data-action="flightlog-device#import" autofocus>Übernehmen</button>
    </div>

  <% } else if (state === 'importing') { -%>
    <progress class="progress" max="<%= progress?.total || 1 %>" <% if (progress?.total) { %>value="<%= progress.done %>"<% } %>></progress>
    <p class="subtle"><%= progress?.text ?? 'Verbinde mit der Fernsteuerung …' %></p>

  <% } else if (state === 'done') { -%>
    <div class="dialog__center"><%- icon('check', { size: 32 }) %>
      <span><%= pluralize(result.added, 'Flugprotokoll', 'Flugprotokolle') %> übernommen<%= result.failed.length ? ` – ${result.failed.length} nicht lesbar` : '' %>.</span>
    </div>
    <div class="dialog__actions">
      <button type="button" class="button" data-action="flightlog-device#close">Schließen</button>
      <button type="button" class="button button--primary" data-action="flightlog-device#showLogs" autofocus>Flugprotokolle ansehen</button>
    </div>

  <% } else { -%>
    <div class="callout callout--danger"><%- icon('alert') %><span class="selectable"><%= error %></span></div>
    <div class="dialog__actions"><button type="button" class="button button--primary" data-action="flightlog-device#close" autofocus>Schließen</button></div>
  <% } -%>
</div>
