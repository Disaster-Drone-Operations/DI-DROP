<%# locals: mission, flight -%>
<li class="timeline__item timeline__item--<%= flight.kind %>">
  <div class="timeline__marker"><%= flight.number %></div>
  <div class="timeline__body">
    <div class="timeline__head">
      <%- flightKindBadge(flight) %>
      <span class="timeline__time"><%= isToday(flight.flownAt) ? formatTime(flight.flownAt) + ' Uhr' : formatDateTime(flight.flownAt) %></span>
    </div>
    <% if (flight.task) { %><p class="timeline__task selectable"><%= flight.task %></p><% } %>
  </div>
  <%- buttonTo('Löschen', `/missions/${mission.id}/flights/${flight.id}`, { method: 'delete', icon: 'trash',
        class: 'button button--icon', confirm: `Flug ${flight.number} löschen?`, confirmButton: 'Löschen' }) %>
</li>
