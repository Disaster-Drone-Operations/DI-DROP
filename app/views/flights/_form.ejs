<%# locals: mission, flight -%>
<% const f = formFor(flight, 'flight') -%>
<form class="card flight-form" action="#/missions/<%= mission.id %>/flights" method="post" novalidate
      data-controller="flight-kind">
  <h3 class="card__title"><%- icon('plus') %> Flug erfassen</h3>
  <div class="grid">
    <div class="field--wide" data-action="change->flight-kind#update">
      <%- f.field('kind', { type: 'segmented', options: flightKindOptions() }) %>
      <p class="hint" data-flight-kind-target="description"><%= flightKindDescription(flight.kind) %></p>
    </div>
    <%- f.field('flown_at', { label: 'Startzeit', type: 'datetime-local' }) %>
    <%- f.field('task', { label: 'Auftrag', wide: true,
          placeholder: flight.kind === 'spezial' ? 'z. B. Rauchentwicklung am Nordhang prüfen' : 'optional – was wird beflogen?' }) %>
  </div>
  <div class="form-actions form-actions--inline">
    <button type="submit" class="button button--primary">Flug erfassen</button>
  </div>
</form>
