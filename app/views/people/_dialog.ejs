<%# locals: person, open, trigger, qualificationTypes, qualifications -%>
<%# New person (person null, trigger "button") or a person that opens its edit dialog: trigger "row" (list row) or "name" -%>
<% const isNew = !person || person.isNewRecord -%>
<% const errors = person?.errors ?? {} -%>
<% const id = isNew ? 'new' : person.id -%>
<div data-controller="dialog" data-dialog-open-value="<%= open ? 'true' : 'false' %>" class="dialog-host">
  <% if (trigger === 'button') { -%>
    <button type="button" class="button button--primary" data-action="dialog#open"><%- icon('plus') %><span>Neue Person</span></button>
  <% } else if (trigger === 'name') { -%>
    <button type="button" class="person-name" data-action="dialog#open" title="Bearbeiten">
      <span class="person-initials"><%= person.short ?? '' %></span>
      <span class="truncate"><%= person.name %></span>
    </button>
  <% } else { -%>
    <button type="button" class="list__row person-row" data-action="dialog#open" title="Bearbeiten">
      <span class="person-initials"><%= person.short ?? '' %></span>
      <span class="person-row__name truncate"><%= person.name %></span>
      <%- icon('chevron', { size: 14, class: 'icon list__chevron' }) %>
    </button>
  <% } -%>
  <dialog class="sheet" data-dialog-target="dialog">
    <form action="#/unit/people<%= isNew ? '' : `/${person.id}` %>" method="post" class="sheet__body" novalidate>
      <% if (!isNew) { %><input type="hidden" name="_method" value="patch"><% } %>
      <h2 class="dialog__title"><%= isNew ? 'Neue Person' : person.name %></h2>

      <div class="field <%= errors.name ? 'field--invalid' : '' %>">
        <label class="field__label" for="person_<%= id %>_name">Name</label>
        <input type="text" id="person_<%= id %>_name" name="person[name]" value="<%= person?.name ?? '' %>" placeholder="Vor- und Nachname" autocomplete="off" autofocus>
        <% if (errors.name) { %><p class="field__error">Name <%= errors.name.join(', ') %></p><% } %>
      </div>

      <div class="field <%= errors.initials ? 'field--invalid' : '' %>">
        <label class="field__label" for="person_<%= id %>_initials">Kürzel</label>
        <input type="text" id="person_<%= id %>_initials" name="person[initials]" value="<%= person?.initials ?? '' %>" size="6" maxlength="6"
               placeholder="<%= isNew ? 'automatisch' : person.short %>" autocomplete="off" class="input-short">
        <% if (errors.initials) { %><p class="field__error">Kürzel <%= errors.initials.join(', ') %></p><% } %>
        <p class="hint">Leer lassen: automatisch aus dem ersten und letzten Namen (Max Mustermann → MM). Gibt es das schon, wird es länger (MMu).</p>
      </div>

      <% if (qualificationTypes?.length) { -%>
        <% const held = isNew ? null : qualifications?.get(person.id) -%>
        <%# Typing a date ticks the qualification (choice_controller.js) -%>
        <fieldset class="field person-qualifications" data-controller="choice" data-choice-on-value="input">
          <legend class="field__label">Nachweise</legend>
          <% qualificationTypes.forEach((t) => { const box = `person_${id}_q${t.id}` -%>
            <div class="person-qualification">
              <label class="checkbox"><input type="checkbox" id="<%= box %>" name="qualifications[<%= t.id %>][has]" value="1" <%= held?.has(t.id) ? 'checked' : '' %>> <%= t.name %></label>
              <label class="person-qualification__until subtle">gültig bis
                <input type="date" name="qualifications[<%= t.id %>][valid_until]" value="<%= held?.get(t.id) ?? '' %>" data-choice="<%= box %>"></label>
            </div>
          <% }) -%>
        </fieldset>
      <% } -%>

      <% if (!isNew) { -%>
        <input type="hidden" name="person[active]" value="0">
        <label class="checkbox"><input type="checkbox" name="person[active]" value="1" <%= person.active ? 'checked' : '' %>> Aktiv – steht bei neuen Einsätzen zur Auswahl</label>
        <p class="hint">Wer nicht mehr dabei ist, wird inaktiv gesetzt statt gelöscht – seine Flüge und Aufträge bleiben in der Statistik.</p>
      <% } -%>

      <div class="dialog__actions">
        <button type="button" class="button" data-action="dialog#close">Abbrechen</button>
        <button type="submit" class="button button--primary"><%= isNew ? 'Anlegen' : 'Speichern' %></button>
      </div>
    </form>
  </dialog>
</div>
