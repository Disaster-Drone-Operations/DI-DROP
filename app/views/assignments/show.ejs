<%# locals: mission, assignment, shots, variant, variants, shotCount, timeline, canImport, completion, provisions, comparisons, comparisonGroups, needsComparisons, people -%>
<% const path = `/missions/${mission.id}/assignments/${assignment.id}` -%>
<% const missionPath = `/missions/${mission.id}` /* „Erledigt“ → back to the mission: the assignment is done with */ -%>
<div data-controller="media-import" data-media-import-mission-id-value="<%= mission.id %>"
     data-media-import-assignment-id-value="<%= assignment.id %>" data-media-import-return-path-value="<%= path %>">
  <header class="page-header">
    <div>
      <a class="backlink" href="#/missions/<%= mission.id %>"><%= mission.title %></a>
      <div class="eyebrow">
        <%- assignmentBadge(assignment) %>
        <% if (assignment.isOpen && !shotCount) { -%>
          <span class="subtle"><%= assignment.dueAt ? `geplant ${formatTime(assignment.dueAt)} Uhr` : 'sofort' %></span>
        <% } else if (assignment.isOpen) { -%>
          <%# Already flown: when it was planned for, without „geplant“ (the flight times are shown below the title) -%>
          <% if (assignment.dueAt) { %><span class="subtle"><%= formatTime(assignment.dueAt) %> Uhr</span><% } %>
        <% } else { -%>
          <span class="badge badge--muted"><%- icon('check', { size: 12 }) %>Erledigt</span>
        <% } -%>
      </div>
      <h1><%= assignment.title %></h1>
      <% if (timeline) { %><div class="meta meta--large"><span><%- icon('clock', { size: 14 }) %><%= timeRange(timeline.first, timeline.last) %></span><span><%- icon('images', { size: 14 }) %><%= pluralize(shotCount, 'Aufnahme', 'Aufnahmen') %></span></div><% } %>
      <% if (shotCount) { %><div class="assignment-provision" data-provision-assignment="<%= assignment.id %>" data-wide></div><% } %>
      <% if (assignment.notes) { %><p class="subtle"><%= assignment.notes %></p><% } %>

      <%# Drone Operator: automatic from the mission's crew (at the first import, without images when done) or by hand -%>
      <% const operator = people.find((p) => p.id === assignment.operator_id) -%>
      <% const manual = assignment.operator_source === 'manual' -%>
      <div data-controller="dialog" class="dialog-host assignment-operator">
        <button type="button" class="assignment-operator__button" data-action="dialog#open" title="<%= roleLabel('operator') %> ändern">
          <span class="subtle"><%= roleLabel('operator') %>:</span>
          <% if (operator) { -%>
            <span class="person-initials person-initials--small <%= manual ? 'is-manual' : '' %>"><%= operator.short %></span><span><%= operator.name %></span>
          <% } else { -%>
            <span class="subtle"><%= manual ? 'niemand' : shotCount || !assignment.isOpen ? '– laut Besetzung niemand –' : 'wird beim ersten Import festgelegt' %></span>
          <% } -%>
          <%- icon('chevron', { size: 12 }) %>
        </button>
        <dialog class="sheet" data-dialog-target="dialog">
          <form action="#<%= path %>/operator" method="post" class="sheet__body" novalidate>
            <input type="hidden" name="_method" value="patch">
            <h2 class="dialog__title"><%= roleLabel('operator') %> – <%= assignment.title %></h2>
            <div class="field">
              <label class="field__label" for="assignment_operator">Wer hat diesen Auftrag ausgewertet?</label>
              <%- include('people/_picker', { name: 'operator', inputId: 'assignment_operator', selected: manual ? (assignment.operator_id ?? '') : 'auto',
                    extra: [['auto', 'Automatisch (Besetzung des Einsatzes)']] }) %>
            </div>
            <p class="hint">Automatisch: wer laut Besetzung des Einsatzes beim ersten Import der Bilder <%= roleLabel('operator') %> war – ohne Bilder beim Erledigen.</p>
            <div class="dialog__actions">
              <button type="button" class="button" data-action="dialog#close">Abbrechen</button>
              <button type="submit" class="button button--primary">Übernehmen</button>
            </div>
          </form>
        </dialog>
      </div>
    </div>
    <div class="toolbar" data-controller="system-open">
      <% if (assignment.media_dir) { -%>
        <button type="button" class="button" data-action="system-open#open" data-system-open-path-param="<%= assignment.media_dir %>"
                title="<%= assignment.media_dir %>"><%- icon('folder') %><span><%= platformName() === 'windows' ? 'Im Explorer öffnen' : 'Im Finder öffnen' %></span></button>
      <% } -%>
      <% if (shotCount) { -%>
        <a class="button" href="#<%= path %>/provide" title="In die Nextcloud laden oder auf einen USB-Stick kopieren"><%- icon('upload') %><span>Bereitstellen …</span></a>
      <% } -%>
      <% if (!shotCount) { -%>
        <%- buttonTo('Löschen', path, { method: 'delete', icon: 'trash', class: 'button button--danger-quiet',
              confirm: `Auftrag „${assignment.title}“ löschen?`, confirmButton: 'Löschen' }) %>
      <% } -%>
      <% if (assignment.isOpen) { -%>
        <span class="dialog-host" <% if (shotCount) { %>data-provision-complete="<%= assignment.id %>" data-provision-title="<%= assignment.title %>"<% } %>>
          <% if (completion) { -%>
            <%- include('assignments/_complete_dialog', { assignment, completion, returnTo: missionPath }) %>
          <% } else { -%>
            <%- buttonTo('Erledigt', `${path}/complete`, { method: 'patch', icon: 'check', class: !shotCount && assignment.kind === 'other' ? 'button button--primary' : 'button', params: { return_to: missionPath } }) %>
          <% } -%>
        </span>
      <% } else { -%>
        <%- buttonTo('Wieder öffnen', `${path}/reopen`, { method: 'patch', icon: 'reopen', params: { return_to: path } }) %>
      <% } -%>
    </div>
  </header>

  <%# Next step: comparison images (control flights) → provide → (done) -%>
  <% if (needsComparisons) { -%>
    <div class="next-step">
      <%- icon('control', { size: 20 }) %>
      <div class="next-step__text"><strong>Nächster Schritt:</strong> Vergleichsbilder aus diesem und früheren Kontrollflügen erstellen.</div>
      <a class="button button--primary" href="#/missions/<%= mission.id %>/comparisons?from=<%= assignment.id %>">Vergleichsbilder erstellen</a>
    </div>
  <% } else if (shotCount && !provisions.length) { -%>
    <div class="next-step">
      <%- icon('upload', { size: 20 }) %>
      <div class="next-step__text"><strong>Nächster Schritt:</strong> <%= comparisons.length ? 'Bilder und Vergleichsbilder' : 'Bilder' %> bereitstellen – in die Nextcloud laden oder auf einen USB-Stick kopieren.</div>
      <a class="button button--primary" href="#<%= path %>/provide">Bereitstellen …</a>
    </div>
  <% } -%>

  <% if (assignment.isOpen && assignment.kind !== 'other') { %><%- include('media/_import_zone', { canImport, label: 'Bilder für diesen Auftrag importieren', compact: shotCount > 0, primary: !shotCount }) %><% } %>

  <% if (variants.length > 1) { -%>
    <nav class="filterbar" aria-label="Kamera">
      <span class="subtle">Anzeigen:</span>
      <div class="segmented segmented--links">
        <% const shown = variant ?? defaultVariantOf(variants) -%>
        <% variants.slice().sort((a, b) => PREFERRED_VARIANTS.indexOf(a) - PREFERRED_VARIANTS.indexOf(b)).forEach((v) => { -%>
          <a href="#<%= path %><%= v === defaultVariantOf(variants) ? '' : `?variant=${v}` %>" class="<%= shown === v ? 'is-active' : '' %>" data-variant-link="<%= v %>"><%= variantLabel(v) %></a>
        <% }) -%>
      </div>
    </nav>
  <% } -%>

  <% if (comparisons.length) { -%>
    <%# One gallery item per comparison – thermal + visible version of the same comparison together (space switches) -%>
    <% const nameOf = new Map(comparisons.map(({ comparison: c, viewpointName }) => [c.id, viewpointName])) -%>
    <section class="section comparison-strip" data-controller="comparison-gallery" data-comparison-gallery-items-value="<%= JSON.stringify(comparisonGroups.groups.map((group) => ({
      key: `c${group[0].id}`, takenAt: group[0].created_at, viewpointName: nameOf.get(group[0].id), assignmentTitle: assignment.title,
      files: Object.fromEntries(group.map((c) => [c.variant ?? 'other', { path: c.path, thumb: c.thumb_path ? thumbUrl(c.thumb_path) : null, name: c.fileName }])),
      variant: group[0].variant ?? 'other',
    }))) %>">
      <h2 class="section__title">Vergleichsbilder <span class="count"><%= comparisons.length %></span></h2>
      <div class="comparison-strip__list">
        <% comparisons.forEach(({ comparison: c, viewpointName }, i) => { -%>
          <button type="button" class="comparison-tile" data-action="comparison-gallery#open" data-comparison-gallery-index-param="<%= comparisonGroups.index.get(c.id) %>"
                  data-comparison-gallery-variant-param="<%= c.variant ?? 'other' %>" title="<%= c.fileName %>">
            <% if (c.thumb_path) { %><img src="<%= thumbUrl(c.thumb_path) %>" alt="" loading="lazy"><% } else { %><span class="comparison-tile__empty"><%- icon('images', { size: 24 }) %></span><% } %>
            <span class="comparison-tile__label"><span class="truncate"><%= viewpointName ?? c.fileName %></span><span class="subtle"><%= variantLabel(c.variant) %></span></span>
          </button>
        <% }) -%>
      </div>
    </section>
  <% } -%>

  <% if (!shots.length && assignment.kind !== 'other') { -%>
    <div class="empty empty--compact"><p class="subtle"><%= variant ? `Keine Aufnahmen mit ${variantLabel(variant)}.` : 'Noch keine Bilder zu diesem Auftrag.' %></p></div>
  <% } else if (shots.length) { -%>
    <p class="hint gallery-hint">Klick auf ein Bild öffnet die große Ansicht – dort mit ← → blättern, mit ↑ ↓ dieselbe Stelle zu anderen Zeiten.</p>
    <div class="shot-grid">
      <% shots.forEach((shot) => { %><%- include('media/_shot', { shot, assignmentTitle: assignment.title }) %><% }) %>
    </div>
  <% } -%>

  <dialog class="import-dialog" data-media-import-target="dialog"></dialog>
</div>
