{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "sql:default",
    "sql:allow-execute",
    "dialog:allow-ask",
    "dialog:allow-open",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "updater:default",
    "process:allow-restart"
  ]
}
